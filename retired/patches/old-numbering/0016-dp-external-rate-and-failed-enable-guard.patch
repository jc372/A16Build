External DP rate fix and failed-enable guard for A16, based on the currently built msm source.
The eDP-only HBR3 override is constrained to the eDP connector; external DP gets its DPCD/LTTPR-negotiated rate and ordinary fallback table. A posted, A16-tested guard prevents PUSH_IDLE on a link that never enabled.

--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -196,7 +196,9 @@
 	 * covers 4-lane 8.1G.  So take the highest rate the DT allows instead of the highest the sink's
 	 * list advertises.
 	 */
-	if (link->max_dp_link_rate >= 810000) {
+	/* This A16 rate workaround is for the internal eDP panel only. */
+	if (msm_dp_panel->connector->connector_type == DRM_MODE_CONNECTOR_eDP &&
+	    link->max_dp_link_rate >= 810000) {
 		link_info->rate = 810000;
 		link_info->rate_set = 3;   /* 0x1E in the eDP supported-link-rates table */
 	}
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1458,6 +1458,10 @@
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 
+	/* A failed link enable never started the main link: do not push idle. */
+	if (!dp->power_on)
+		return;
+
 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
 }
 
