@@ -198,8 +198,28 @@
 	set_bit(ATH12K_FLAG_A16_RESUMING, &ab->dev_flags);
 	ret = ath12k_hif_power_up(ab);
 	clear_bit(ATH12K_FLAG_A16_RESUMING, &ab->dev_flags);
-	if (ret)
+	if (ret) {
 		ath12k_warn(ab, "failed to power up hif during resume: %d\n", ret);
+		return ret;
+	}
+
+	/* A16: with the SoC global reset skipped (see ath12k_pci_power_up()) the device was never
+	 * rebooted: MHI was re-attached to a firmware that is still running (measured 2026-09-22:
+	 * "MHI state after power up: 0x2", i.e. M0), so nothing will announce itself the way a rebooted
+	 * device does, and the wait in ath12k_core_resume() expires after 20 s leaving the radio
+	 * half-attached ("A16: resume timed out -- no firmware-ready event arrived after the resume",
+	 * then every WMI command failing).
+	 *
+	 * So do what the firmware-crash path does for a device that is already running: re-attach the
+	 * driver to it (ath12k_core_reconfigure_on_crash() -> ath12k_core_qmi_firmware_ready() ->
+	 * ath12k_core_start(), which redoes the HTC/WMI handshake).  That path also completes
+	 * restart_completed, which is what ath12k_core_resume() is waiting for.
+	 */
+	if (test_and_clear_bit(ATH12K_FLAG_A16_KEPT_DEVICE, &ab->dev_flags)) {
+		ath12k_info(ab, "A16: resume -- device kept across the suspend; re-attaching the driver to it\n");
+		set_bit(ATH12K_FLAG_RECOVERY, &ab->dev_flags);
+		queue_work(ab->workqueue, &ab->restart_work);
+	}
 
 	return ret;
 }
