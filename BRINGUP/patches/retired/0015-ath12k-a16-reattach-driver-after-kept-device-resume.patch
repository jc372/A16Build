 	 */
 	ATH12K_FLAG_A16_RESUMING,
+
+	/* A16: the PCI HAL did skip the SoC global reset on that resume, so the device is still
+	 * running its firmware (MHI re-attached, state M0) and the driver has to re-attach to it
