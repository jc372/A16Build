+
+static int qmp_v8_dp_ln_drive_level(struct qmp_combo *qmp, u8 *level)
+{
+	const struct phy_configure_opts_dp *dp_opts = &qmp->dp_opts;
+	const struct qmp_phy_cfg *cfg = qmp->cfg;
+	const u8 (*table)[4][4];
+	unsigned int v_level = 0, p_level = 0;
+	int i;
+
+	if (!dp_opts->lanes || dp_opts->lanes > ARRAY_SIZE(dp_opts->voltage))
+		return -EINVAL;
+
+	for (i = 0; i < dp_opts->lanes; i++) {
+		v_level = max(v_level, dp_opts->voltage[i]);
+		p_level = max(p_level, dp_opts->pre[i]);
+	}
+
+	if (v_level >= 4 || p_level >= 4)
+		return -EINVAL;
+
+	switch (dp_opts->link_rate) {
+	case 1620:
+	case 2700:
+		table = cfg->ln_drv_lvl_hbr_rbr;
+		break;
+	case 5400:
+	case 8100:
+		table = cfg->ln_drv_lvl_hbr3_hbr2;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!table || (*table)[v_level][p_level] == 0xff)
+		return -EINVAL;
+
+	*level = (*table)[v_level][p_level];
+	return 0;
+}
+
+static void qmp_v8_configure_dp_tx(struct qmp_combo *qmp)
+{
+	u8 level;
+
+	/* Preserve the existing power-on sequence; clocks program PCS initially. */
+	if (!qmp->dp_powered_on) {
+		qmp_v4_configure_dp_tx(qmp);
+		return;
+	}
+
+	if (qmp_v8_dp_ln_drive_level(qmp, &level)) {
+		dev_warn(qmp->dev, "invalid DP PCS drive level request\n");
+		return;
+	}
+
+	qmp_v4_configure_dp_tx(qmp);
+	writel(level, qmp->dp_dp_phy + QSERDES_V8_DP_PHY_LN0_DRV_LVL);
+	writel(level, qmp->dp_dp_phy + QSERDES_V8_DP_PHY_LN1_DRV_LVL);
+	pr_info("A16 QMP DP PCS LN drive level 0x%02x at %u Mbps\n",
+		level, qmp->dp_opts.link_rate);
 }
 
