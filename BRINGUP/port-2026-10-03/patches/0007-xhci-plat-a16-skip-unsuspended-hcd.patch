From: Hermes <hermes@localhost>
Subject: usb: host: xhci-plat: do not fail the system suspend when the HCD was left unsuspended (A16)

Rebased against next-20261002. Upstream lines are only added to; the sole edit to an upstream
line is the guard wrapping `if (ret) return ret;` in xhci_plat_suspend_common().
Provenance: ours, workaround. Verify with `sudo lid_sleep test 2` -- both attempts should sleep.

--- a/drivers/usb/host/xhci-plat.c
+++ b/drivers/usb/host/xhci-plat.c
@@ -466,6 +466,74 @@
 }
 EXPORT_SYMBOL_GPL(xhci_plat_remove);
 
+/*
+ * A16 (glymur-asus-zenbook-a16-ux3607oa) -- the second and later system suspends of a boot abort
+ * because the USB core does not leave this HCD in the state xhci_suspend() requires:
+ *
+ *   xhci-hcd xhci-hcd.1.auto: PM: dpm_run_callback(): platform_pm_suspend returns -22
+ *   xhci-hcd xhci-hcd.1.auto: PM: failed to suspend async: error -22
+ *
+ * -22 is -EINVAL from xhci_suspend() (drivers/usb/host/xhci.c), returned when hcd->state or
+ * xhci->shared_hcd->state is not HC_STATE_SUSPENDED, i.e. when the USB core did not suspend this
+ * HCD's root hubs. Because the platform callback fails, the whole system suspend is aborted, and
+ * systemd-logind retries it every ~33 s while the lid stays shut: the machine never sleeps.
+ *
+ * Nothing in userspace can put hcd->state right, so leave the controller running and let the system
+ * suspend proceed -- the controller was never stopped, so there is nothing to resume either, and the
+ * resume half skips symmetrically. Both behaviours are module parameters so a boot can be compared
+ * with and without them:
+ *
+ *   /sys/module/xhci_plat_hcd/parameters/a16_skip_unsuspended_hcd   (fix; default 1)
+ *   /sys/module/xhci_plat_hcd/parameters/a16_state_log              (diagnostic; default 1)
+ */
+struct a16_xhci_state {
+	struct xhci_hcd *xhci;
+	bool skipped_suspend;
+};
+
+static struct a16_xhci_state a16_xhci_states[4];
+static bool a16_skip_unsuspended_hcd = 1;
+static bool a16_state_log = 1;
+module_param(a16_skip_unsuspended_hcd, bool, 0644);
+module_param(a16_state_log, bool, 0644);
+
+static struct a16_xhci_state *a16_xhci_state(struct xhci_hcd *xhci)
+{
+	struct a16_xhci_state *slot = NULL;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(a16_xhci_states); i++) {
+		if (a16_xhci_states[i].xhci == xhci)
+			return &a16_xhci_states[i];
+		if (!a16_xhci_states[i].xhci && !slot)
+			slot = &a16_xhci_states[i];
+	}
+
+	if (!slot)
+		slot = &a16_xhci_states[0];
+
+	slot->xhci = xhci;
+	return slot;
+}
+
+static void a16_log_hcd_state(struct device *dev, const char *where)
+{
+	struct usb_hcd *hcd = dev_get_drvdata(dev);
+	struct xhci_hcd *xhci = hcd_to_xhci(hcd);
+	struct usb_hcd *shared = xhci->shared_hcd;
+
+	if (!a16_state_log)
+		return;
+
+	dev_info(dev,
+		 "A16 %s: hcd state=%d flags=0x%lx root_hub=%d | "
+		 "shared state=%d root_hub=%d | wakeup=%d quirks=0x%llx\n",
+		 where, hcd->state, hcd->flags, hcd->self.root_hub->state,
+		 shared ? shared->state : -1,
+		 shared ? shared->self.root_hub->state : -1,
+		 device_may_wakeup(dev), (unsigned long long)xhci->quirks);
+}
+
 static int xhci_plat_suspend_common(struct device *dev)
 {
 	struct usb_hcd	*hcd = dev_get_drvdata(dev);
@@ -478,13 +546,28 @@
 	ret = xhci_priv_suspend_quirk(hcd);
 	if (ret)
 		return ret;
+	a16_log_hcd_state(dev, "suspend");
+
 	/*
 	 * xhci_suspend() needs `do_wakeup` to know whether host is allowed
 	 * to do wakeup during suspend.
 	 */
 	ret = xhci_suspend(xhci, device_may_wakeup(dev));
-	if (ret)
+	if (ret) {
+		if (ret == -EINVAL && hcd->state != HC_STATE_SUSPENDED &&
+		    a16_skip_unsuspended_hcd) {
+			dev_info(dev,
+				 "A16: HCD left unsuspended (state=%d, shared=%d), "
+				 "leaving the controller running so the system "
+				 "suspend can proceed\n",
+				 hcd->state,
+				 xhci->shared_hcd ? xhci->shared_hcd->state : -1);
+			a16_xhci_state(xhci)->skipped_suspend = true;
+			return 0;
+		}
+
 		return ret;
+	}
 
 	if (!device_may_wakeup(dev) && (xhci->quirks & XHCI_SUSPEND_RESUME_CLKS)) {
 		clk_disable_unprepare(xhci->clk);
@@ -518,8 +601,18 @@
 	struct usb_hcd	*hcd = dev_get_drvdata(dev);
 	struct xhci_plat_priv *priv = hcd_to_xhci_priv(hcd);
 	struct xhci_hcd	*xhci = hcd_to_xhci(hcd);
+	struct a16_xhci_state *a16_state = a16_xhci_state(xhci);
 	int ret;
 
+	/* A16: the suspend was skipped, so the controller never stopped. */
+	if (a16_state->skipped_suspend) {
+		a16_state->skipped_suspend = false;
+		a16_log_hcd_state(dev, "resume (suspend was skipped)");
+		return 0;
+	}
+
+	a16_log_hcd_state(dev, "resume");
+
 	if (!device_may_wakeup(dev) && (xhci->quirks & XHCI_SUSPEND_RESUME_CLKS)) {
 		ret = clk_prepare_enable(xhci->clk);
 		if (ret)
