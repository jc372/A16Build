# Kernel mailing-list message IDs, newest compatible series first.
# Update A16_SERIES_MSGID when Qualcomm posts a v2/v3.
A16_SERIES_MSGID="20260721-topic-a16_submission-v1-0-8ea213130d05@oss.qualcomm.com"

# linux-next already contains patches 1 and 2 from this series (binding and
# board DTS). Only patch 3 remains missing as of 2026-08-10. b4's selection is
# intentionally explicit so later edits to integrated patches cannot block CI.
# Empty means apply the entire series.
A16_PATCH_SELECTION="3"

# Optional prerequisite series. One message ID per line; blank/comment lines ignored.
# Add only a dependency that is proven missing from linux-next.
DEPENDENCY_SERIES_MSGIDS=(
)
