-int msm_dp_link_adjust_levels(struct msm_dp_link *msm_dp_link, u8 *link_status)
+/*
+ * Highest voltage swing / pre-emphasis level that may be requested from the
+ * PHY segment being trained.
+ *
+ * An LTTPR advertises the maximum drive levels it can apply in its PHY
+ * capability registers (DP_TRANSMITTER_CAPABILITY_PHY_REPEATER<n>).  Driving
+ * a level the repeater does not support silently corrupts the link: the
+ * observed Glymur/msm behaviour is that once pre-emphasis 3 was forced into a
+ * repeater that never advertised it, clock recovery collapsed and channel
+ * equalization could no longer converge.  Clamp to the advertised maximum and
+ * signal "max reached" at that clamped value (see
+ * msm_dp_ctrl_update_phy_vx_px()), so a repeater asking for an unsupported
+ * level is answered instead of being pushed past its limit.
+ */
+void msm_dp_link_get_max_levels(struct msm_dp_link *msm_dp_link,
+				enum drm_dp_phy dp_phy, u8 *v_max, u8 *p_max)
+{
+	u8 v_level = DP_TRAIN_LEVEL_MAX;
+	u8 p_level = DP_TRAIN_LEVEL_MAX;
+
+	if (dp_phy >= DP_PHY_LTTPR1 && dp_phy <= DP_PHY_LTTPR8) {
+		const u8 *caps = msm_dp_link->lttpr_phy_caps[dp_phy - DP_PHY_LTTPR1];
+
+		if (!drm_dp_lttpr_voltage_swing_level_3_supported(caps))
+			v_level = DP_TRAIN_LEVEL_MAX - 1;
+		if (!drm_dp_lttpr_pre_emphasis_level_3_supported(caps))
+			p_level = DP_TRAIN_LEVEL_MAX - 1;
+	}
+
+	*v_max = v_level;
+	*p_max = p_level;
+}
