# ASUS Zenbook A16 / Glymur early-boot requirements.
# Keep supplier, storage, USB, display, and remoteproc drivers built in because
# the disposable image must boot before a matching initramfs can load modules.
# Both known-booting distro kernels (Ubuntu 7.0 and Tumbleweed 7.1.5) use
# 48-bit virtual and physical addressing. The 52-bit linux-next build returned
# to firmware before producing a kernel console, so keep this first diagnostic
# rebuild aligned with the working firmware/kernel memory layout.
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
CONFIG_COMMON_CLK_QCOM=y
CONFIG_CLK_GLYMUR_GCC=y
CONFIG_CLK_GLYMUR_DISPCC=y
CONFIG_CLK_GLYMUR_GPUCC=y
CONFIG_CLK_GLYMUR_TCSRCC=y
CONFIG_CLK_GLYMUR_VIDEOCC=y
CONFIG_PINCTRL_GLYMUR=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_GLYMUR=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_PDC=y
CONFIG_SPMI=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_ARM_SMMU_V3=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_CORE=y
# Keep both firmware-description paths usable. The DTB entry uses OF while the
# now-booting ACPI entry depends on the ACPI companion driver being available
# before the live root has completed module discovery.
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_HID_OF=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_RPMB=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_DRM=y
# Match the display handoff used by the Ubuntu and Tumbleweed kernels that boot
# this machine: keep simpledrm and the framebuffer console built in, but defer
# the hardware-specific MSM/eDP takeover until userspace can load the modules.
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_EDP=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
# CONFIG_FB_EFI is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_ATH12K=m
CONFIG_MHI_BUS=m
CONFIG_QRTR=m
CONFIG_QRTR_MHI=m
CONFIG_BTRFS_FS=y
# Ubuntu Casper must mount the ISO9660 image and its compressed SquashFS root
# before it can switch to the live userspace. Keep this entire discovery path
# built in; VirtualBox also presents the ISO through sr_mod.
CONFIG_BLK_DEV_SR=y
# VirtualBox ARM presents both its virtual DVD and installation disk through
# VirtioSCSI. Without this built in, GRUB can load the kernel/initramfs through
# EFI but Casper cannot see the same DVD after Linux takes control.
CONFIG_SCSI_VIRTIO=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
