# Kernel mailing-list message IDs, newest compatible series first.
# Update A16_SERIES_MSGID when Qualcomm posts a v2/v3.
A16_SERIES_MSGID="20260721-topic-a16_submission-v1-0-8ea213130d05@oss.qualcomm.com"

# The complete A16 v1 series (binding, board DTS, and QSEECOM firmware allowlist)
# has landed in linux-next as of 2026-08-14. An empty selection applies the
# whole series and lets scripts/apply-series.sh skip whatever the configured
# linux-next tree already contains (forward/reverse apply check), so the same
# series.env stays correct for both the pinned known-good revision and a newer
# unpinned tree.
A16_PATCH_SELECTION=""

# Optional prerequisite series. One message ID per line; blank/comment lines ignored.
# Add only a dependency that is proven missing from linux-next.
DEPENDENCY_SERIES_MSGIDS=(
)
