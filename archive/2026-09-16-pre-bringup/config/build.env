# Reproducible upstream inputs used by the nightly kernel and USB image jobs.
FEDORA_CONFIG_URL="https://src.fedoraproject.org/rpms/kernel/raw/rawhide/f/kernel-aarch64-fedora.config"
QCOM_FIRMWARE_BASE_URL="https://dl.fedoraproject.org/pub/fedora/linux/development/rawhide/Everything/aarch64/os/Packages/q"
ATHEROS_FIRMWARE_BASE_URL="https://dl.fedoraproject.org/pub/fedora/linux/development/rawhide/Everything/aarch64/os/Packages/a"

# Ubuntu media is built from the selected daily-live series. resolute (26.04
# LTS) is the default; its installer is the current install target (the
# previous stonking installer was broken on the A16). Override per build with
# `--ubuntu-series <series>` on the WSL launcher; stonking remains available
# as the previously verified live-session baseline.
UBUNTU_DAILY_SERIES="resolute"

# Historical linux-next baseline last known to reach the visible Fedora boot
# path on the A16. The launcher now tracks linux-next master by default; these
# are kept as a documented reproducible fallback for `--ref`.
KNOWN_GOOD_LINUX_NEXT_REVISION="3d08ff75a47a3e7e2ab45a3bcab6723b4d906422"
KNOWN_GOOD_REPO_REVISION="487394893ae39fd4eb44edffea7090cd3e6e0a2f"

# The matching Rawhide compose is kept in Fedora's compose archive, rather
# than the rolling mirror which replaces images as new composes appear.
KNOWN_GOOD_FEDORA_XFCE_IMAGE_URL="https://kojipkgs.fedoraproject.org/compose/rawhide/Fedora-Rawhide-20260811.n.0/compose/Spins/aarch64/images/Fedora-Xfce-Disk-Rawhide-20260811.n.0.aarch64.raw.xz"
KNOWN_GOOD_FEDORA_XFCE_IMAGE_SHA256="2db379c898ae6c581cca7bf0caa737dd85dd5342395066be743167a8634b9520"
